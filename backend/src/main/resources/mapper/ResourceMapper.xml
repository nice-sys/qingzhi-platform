<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qingzhi.demo.mapper.ResourceMapper">

    <!-- ============================================================
         字段映射 + 基础列
         ============================================================ -->
    <resultMap id="ResourceResultMap" type="com.qingzhi.demo.entity.Resource">
        <id     property="id"              column="id"               />
        <result property="title"           column="title"            />
        <result property="description"     column="description"      />
        <result property="course"          column="course"           />
        <result property="uploaderId"      column="uploader_id"      />
        <result property="fileName"        column="file_name"        />
        <result property="filePath"        column="file_path"        />
        <result property="fileSize"        column="file_size"        />
        <result property="fileExt"         column="file_ext"         />
        <result property="fileHash"        column="file_hash"        />
        <result property="downloadCount"   column="download_count"   />
        <result property="reviewStatus"    column="review_status"    />
        <result property="rejectReason"    column="reject_reason"    />
        <result property="reviewAdminId"   column="review_admin_id"  />
        <result property="reviewTime"      column="review_time"      />
        <result property="createTime"      column="create_time"      />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <sql id="Base_Column_List">
        id, title, description, course, uploader_id, file_name, file_path,
        file_size, file_ext, file_hash, download_count, review_status,
        reject_reason, review_admin_id, review_time, create_time, update_time
    </sql>

    <!-- ============================================================
         1. 按条件统计资源总数（分页 total）
         ============================================================ -->
    <select id="countResources" parameterType="map" resultType="long">
        SELECT COUNT(1)
        FROM resource
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                     OR description LIKE CONCAT('%', #{keyword}, '%')
                     OR course LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="course != null and course != ''">
                AND course LIKE CONCAT('%', #{course}, '%')
            </if>
            <if test="reviewStatus != null">
                AND review_status = #{reviewStatus}
            </if>
            <if test="uploaderId != null">
                AND uploader_id = #{uploaderId}
            </if>
            <if test="startDate != null">
                AND create_time <![CDATA[>=]]> CONCAT(#{startDate}, ' 00:00:00')
            </if>
            <if test="endDate != null">
                AND create_time <![CDATA[<]]> CONCAT(DATE_ADD(#{endDate}, INTERVAL 1 DAY), ' 00:00:00')
            </if>
        </where>
    </select>

    <!-- ============================================================
         1.1 按条件统计资源总数（带排除状态）
         - excludeStatus 不为 null 时，追加 review_status != #{excludeStatus}
         - 主要用于：管理员全局列表默认排除 DRAFT(3) 草稿，避免混淆
         ============================================================ -->
    <select id="countResourcesExcludeStatus" parameterType="map" resultType="long">
        SELECT COUNT(1)
        FROM resource
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                     OR description LIKE CONCAT('%', #{keyword}, '%')
                     OR course LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="course != null and course != ''">
                AND course LIKE CONCAT('%', #{course}, '%')
            </if>
            <if test="reviewStatus != null">
                AND review_status = #{reviewStatus}
            </if>
            <if test="excludeStatus != null">
                AND review_status != #{excludeStatus}
            </if>
            <if test="uploaderId != null">
                AND uploader_id = #{uploaderId}
            </if>
            <if test="startDate != null">
                AND create_time <![CDATA[>=]]> CONCAT(#{startDate}, ' 00:00:00')
            </if>
            <if test="endDate != null">
                AND create_time <![CDATA[<]]> CONCAT(DATE_ADD(#{endDate}, INTERVAL 1 DAY), ' 00:00:00')
            </if>
        </where>
    </select>

    <!-- ============================================================
         2. 按条件分页查询资源列表（按发布时间倒序）
         ============================================================ -->
    <select id="selectResourcesPage" parameterType="map" resultMap="ResourceResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM resource
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                     OR description LIKE CONCAT('%', #{keyword}, '%')
                     OR course LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="course != null and course != ''">
                AND course LIKE CONCAT('%', #{course}, '%')
            </if>
            <if test="reviewStatus != null">
                AND review_status = #{reviewStatus}
            </if>
            <if test="uploaderId != null">
                AND uploader_id = #{uploaderId}
            </if>
            <if test="startDate != null">
                AND create_time <![CDATA[>=]]> CONCAT(#{startDate}, ' 00:00:00')
            </if>
            <if test="endDate != null">
                AND create_time <![CDATA[<]]> CONCAT(DATE_ADD(#{endDate}, INTERVAL 1 DAY), ' 00:00:00')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- ============================================================
         2.1 按条件分页查询资源列表（带排除状态）
         ============================================================ -->
    <select id="selectResourcesPageExcludeStatus" parameterType="map" resultMap="ResourceResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM resource
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                     OR description LIKE CONCAT('%', #{keyword}, '%')
                     OR course LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="course != null and course != ''">
                AND course LIKE CONCAT('%', #{course}, '%')
            </if>
            <if test="reviewStatus != null">
                AND review_status = #{reviewStatus}
            </if>
            <if test="excludeStatus != null">
                AND review_status != #{excludeStatus}
            </if>
            <if test="uploaderId != null">
                AND uploader_id = #{uploaderId}
            </if>
            <if test="startDate != null">
                AND create_time <![CDATA[>=]]> CONCAT(#{startDate}, ' 00:00:00')
            </if>
            <if test="endDate != null">
                AND create_time <![CDATA[<]]> CONCAT(DATE_ADD(#{endDate}, INTERVAL 1 DAY), ' 00:00:00')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- ============================================================
         3. 按主键查询资源
         ============================================================ -->
    <select id="selectById" resultMap="ResourceResultMap" parameterType="long">
        SELECT
        <include refid="Base_Column_List" />
        FROM resource
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- ============================================================
         4. 审核资源（通过/拒绝）
         - 写入 review_status / reject_reason / review_admin_id / review_time
         ============================================================ -->
    <update id="updateReviewStatus" parameterType="com.qingzhi.demo.entity.Resource">
        UPDATE resource
        SET review_status   = #{reviewStatus},
            reject_reason   = #{rejectReason},
            review_admin_id = #{reviewAdminId},
            review_time     = #{reviewTime},
            update_time     = NOW()
        WHERE id = #{id}
    </update>

    <!-- ============================================================
         5. 插入新资源（发布资源）
         - create_time / update_time 自动赋值 NOW()
         - review_status 默认 0（待审核），download_count 默认 0
         - useGeneratedKeys 回填 id 到 Resource.id
         ============================================================ -->
    <insert id="insert" parameterType="com.qingzhi.demo.entity.Resource"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resource
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="description != null">description,</if>
            <if test="course != null">course,</if>
            <if test="uploaderId != null">uploader_id,</if>
            <if test="fileName != null">file_name,</if>
            <if test="filePath != null">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="fileExt != null">file_ext,</if>
            <if test="fileHash != null">file_hash,</if>
            review_status,
            <if test="rejectReason != null">reject_reason,</if>
            download_count,
            create_time,
            update_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="course != null">#{course},</if>
            <if test="uploaderId != null">#{uploaderId},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="fileExt != null">#{fileExt},</if>
            <if test="fileHash != null">#{fileHash},</if>
            COALESCE(#{reviewStatus}, 0),
            <if test="rejectReason != null">#{rejectReason},</if>
            COALESCE(#{downloadCount}, 0),
            COALESCE(#{createTime}, NOW()),
            COALESCE(#{updateTime}, NOW())
        </trim>
    </insert>

    <!-- ============================================================
         6. 根据主键动态更新资源（修改资源）
         - 只更新非空字段，空值不覆盖原值
         - update_time 强制刷新为 NOW()
         - 注意：修改通过的资源后，review_status 应由 Service 层显式
           传入 0（待审核），触发重新审核
         ============================================================ -->
    <update id="updateById" parameterType="com.qingzhi.demo.entity.Resource">
        UPDATE resource
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="course != null">course = #{course},</if>
            <if test="uploaderId != null">uploader_id = #{uploaderId},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="fileExt != null">file_ext = #{fileExt},</if>
            <if test="fileHash != null">file_hash = #{fileHash},</if>
            <if test="reviewStatus != null">review_status = #{reviewStatus},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="downloadCount != null">download_count = #{downloadCount},</if>
            update_time = NOW()
        </trim>
        WHERE id = #{id}
    </update>

    <!-- ============================================================
         7. 根据主键删除资源
         ============================================================ -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM resource WHERE id = #{id}
    </delete>

    <!-- ============================================================
         8. 下载量原子自增 +1（避免并发丢失更新）
         - 同时 update_time 不强制刷新（不打扰资源真实最后更新时间）
           如果要记录"最后下载时间"可以加列，这里 PRD 没要求。
         ============================================================ -->
    <update id="incrementDownloadCount" parameterType="long">
        UPDATE resource
        SET download_count = COALESCE(download_count, 0) + 1
        WHERE id = #{id}
    </update>

    <!-- ============================================================
         9. 首页 Dashboard 聚合统计（一条 SQL 一次返回所有指标，避免 N+1）
         - resourceTotal     : 平台资源总数
         - approvedCount     : 已通过审核资源数(review_status=1)
         - pendingCount      : 待审核资源数(review_status=0)
         - rejectedCount     : 已拒绝资源数(review_status=2)
         - downloadTotal     : 累计下载总次数(SUM(download_count))
         - todayDownloadCount: 今日下载次数（resource 无下载日志表，暂时与总累计保持一致，
                               预留字段后续加 download_log 表后替换）
         ============================================================ -->
    <select id="selectDashboardStats" resultType="map">
        SELECT
            COUNT(1)                                                    AS resourceTotal,
            SUM(CASE WHEN review_status = 1 THEN 1 ELSE 0 END)         AS approvedCount,
            SUM(CASE WHEN review_status = 0 THEN 1 ELSE 0 END)         AS pendingCount,
            SUM(CASE WHEN review_status = 2 THEN 1 ELSE 0 END)         AS rejectedCount,
            COALESCE(SUM(download_count), 0)                           AS downloadTotal,
            COALESCE(SUM(download_count), 0)                           AS todayDownloadCount
        FROM resource
    </select>

</mapper>
